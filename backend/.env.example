# ---------------------------------------------------------------- database
# Local dev (SQLite, default when unset):   sqlite:////absolute/path/backend/meditrust_dev.db
# Docker compose Postgres:                  postgresql+psycopg2://meditrust:meditrust_pw@127.0.0.1:5433/meditrust_db
# AWS RDS Postgres:                         postgresql+psycopg2://USER:PASSWORD@your-db.xxxx.us-east-1.rds.amazonaws.com:5432/meditrust?sslmode=require
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/meditrust_db

# ---------------------------------------------------------------- auth
# Universal admin seeded on startup. Set a strong password in production.
ADMIN_EMAIL=meditrust@gmail.com
ADMIN_PASSWORD=change-me
# Signing key for JWT access tokens (required in production; generated into backend/.jwt_secret otherwise)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Extra CORS origins (comma separated). Localhost dev ports are always allowed.
ALLOWED_ORIGINS=http://meditrust.ddns.net,https://meditrust.ddns.net

# ---------------------------------------------------------------- LLM (optional)
# When set, Gemini writes the evidence-grounded narrative; otherwise a deterministic template is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# ---------------------------------------------------------------- RAG
RAG_ENABLED=true
RAG_TOP_K=6
RAG_USE_LLM=true
# Optional dense embeddings (requires `pip install sentence-transformers`), e.g. all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL=

# ---------------------------------------------------------------- model artifacts
# Defaults to ../ml/models. Set MODEL_S3_URI to pull artifacts published by CI, e.g. s3://meditrust-artifacts/models/latest
MODEL_DIR=
MODEL_S3_URI=
AWS_REGION=us-east-1
# Override the tuned triage thresholds (probability of disease) if needed
RISK_RULE_OUT=
RISK_RULE_IN=

# ---------------------------------------------------------------- observability
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true

# ---------------------------------------------------------------- SMTP (password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=MediTrust
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
SMTP_FALLBACK_TO_LOG=true
